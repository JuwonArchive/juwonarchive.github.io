---
import type { Work } from '../lib/site-schema';
import { config } from '../config';
import { longestWord } from '../lib/fit';

interface Props {
  works: Work[];
}
const { works } = Astro.props;
---

<ol class="list" data-category-list>
  {
    works.map((w, i) => (
      <li>
        <a
          class="item"
          href={`/works/${w.slug}`}
          data-category-item
          data-cover={w.cover?.src ?? ''}
          data-bg={config.pastels[i % config.pastels.length]}
        >
          <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="title display fit" data-title style={`--chars:${longestWord(w.titleEn)}`}>
            {w.titleEn}
          </span>
        </a>
      </li>
    ))
  }
</ol>

<script>
  const list = document.querySelector<HTMLElement>('[data-category-list]');
  const items = document.querySelectorAll<HTMLAnchorElement>('[data-category-item]');
  const reset = () => {
    document.body.style.removeProperty('--page-bg');
    list?.removeAttribute('data-hovering');
  };
  for (const item of items) {
    const enter = () => {
      document.body.style.setProperty('--page-bg', item.dataset.bg ?? '');
      list?.setAttribute('data-hovering', '');
    };
    item.addEventListener('pointerenter', enter);
    item.addEventListener('focus', enter);
    item.addEventListener('pointerleave', reset);
    item.addEventListener('blur', reset);
  }
</script>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter);
  }
  .item {
    display: flex;
    align-items: baseline;
    gap: clamp(8px, 1.5vw, 24px);
    padding: 0.08em 0;
    text-decoration: none;
    transition: opacity 300ms var(--ease);
  }
  .num {
    flex: none;
    width: 2.5em;
    color: var(--muted);
  }
  .title {
    --fit-max: min(8vw, 120px);
    --fit-width: (100vw - 2 * var(--gutter) - 2.5 * 11px - clamp(8px, 1.5vw, 24px));
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  [data-hovering] .item:not(:hover):not(:focus-visible) {
    opacity: 0.25;
  }
</style>
