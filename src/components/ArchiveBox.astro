---
import type { Work } from '../lib/site-schema';

interface Props {
  work: Work;
  index: number;
  tint: string;
}
const { work, index, tint } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<a class="box" href={`/archive/${work.slug}`} data-archive-box style={`--tint:${tint}`}>
  <span class="scene" aria-hidden="true">
    <span class="cube">
      <span class="glow"></span>
      <span class="f back"></span>
      <span class="f left"></span>
      <span class="card" style={work.cover?.width && work.cover?.height ? `--ar:${(work.cover.width / work.cover.height).toFixed(4)}` : undefined}>
        {
          work.cover ? (
            <img src={work.cover.src} width={work.cover.width} height={work.cover.height} alt="" loading="lazy" decoding="async" />
          ) : (
            <span class="mono card-title" data-box-face-title>
              {work.titleEn}
            </span>
          )
        }
      </span>
      <span class="f lid"></span>
      <span class="f side"></span>
      <span class="f front"><span class="etch mono">JUWON ARCHIVE — {num}</span></span>
    </span>
  </span>
  <span class="label mono">
    <span class="num">{num}</span>
    <span data-box-name>{work.titleEn}</span>
  </span>
</a>

<style>
  /* Theme B — frosted acrylic box: the work floats inside, the floor glows in the work's tint. */
  .box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-decoration: none;
    color: inherit;
    outline-offset: 8px;
  }
  .scene {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 4;
    perspective: 1000px;
    container-type: inline-size;
  }
  /* Every face starts at the cube centre and is pushed out by half the cube's size. */
  .cube {
    --W: 70cqw;
    --H: 50cqw;
    --D: 46cqw;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(-16deg) rotateY(-30deg);
    transition: transform 700ms var(--ease);
  }
  .f,
  .card,
  .glow {
    position: absolute;
    left: 50%;
    top: 50%;
    display: block;
  }
  /* On a pure white page the glass needs a faint cool tint and hairline edges to read as a box. */
  .f {
    background: linear-gradient(135deg, rgba(232, 236, 245, 0.55), rgba(214, 221, 236, 0.22) 45%, rgba(236, 240, 248, 0.5));
    border: 1px solid rgba(40, 52, 90, 0.16);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.8),
      inset 0 0 18px rgba(255, 255, 255, 0.7);
  }
  .front {
    width: var(--W);
    height: var(--H);
    transform: translate(-50%, -50%) translateZ(calc(var(--D) / 2));
  }
  .back {
    width: var(--W);
    height: var(--H);
    transform: translate(-50%, -50%) translateZ(calc(var(--D) / -2));
  }
  .side {
    width: var(--D);
    height: var(--H);
    transform: translate(-50%, -50%) rotateY(90deg) translateZ(calc(var(--W) / 2));
  }
  .left {
    width: var(--D);
    height: var(--H);
    transform: translate(-50%, -50%) rotateY(-90deg) translateZ(calc(var(--W) / 2));
  }
  .lid {
    width: var(--W);
    height: var(--D);
    transform: translate(-50%, -50%) rotateX(90deg) translateZ(calc(var(--H) / 2));
    transition:
      transform 600ms var(--ease),
      opacity 400ms ease;
  }
  .glow {
    width: calc(var(--W) * 1.3);
    height: calc(var(--D) * 1.3);
    transform: translate(-50%, -50%) rotateX(90deg) translateZ(calc(var(--H) / -2 - 1px));
    background: radial-gradient(closest-side, var(--tint), transparent);
    filter: blur(4px);
  }
  /* The card takes the cover's own shape, as large as fits in the box: nothing is cropped (user). */
  .card {
    --ar: 1.2923; /* no cover: the box's own card shape */
    width: min(calc(var(--W) * 0.72), calc(var(--H) * 0.78 * var(--ar)));
    aspect-ratio: var(--ar);
    overflow: hidden;
    border-radius: 3px;
    background: var(--tint);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
    transform: translate(-50%, -50%) translateZ(2px);
    transition: transform 600ms var(--ease);
  }
  .card img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .card-title {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 10px;
    text-align: center;
  }
  .etch {
    position: absolute;
    left: 8%;
    bottom: 6%;
    font-size: 8px;
    letter-spacing: 0.1em;
    color: rgba(17, 17, 17, 0.55);
  }

  /* Hover: the lid lifts and the work rises out of the box. */
  .box:not([data-opening]):hover .cube,
  .box:not([data-opening]):focus-visible .cube {
    transform: rotateX(-12deg) rotateY(-20deg) translateY(-4px);
  }
  .box:not([data-opening]):hover .lid,
  .box:not([data-opening]):focus-visible .lid {
    transform: translate(-50%, -50%) rotateX(90deg) translateZ(calc(var(--H) / 2 + 14px));
  }
  .box:not([data-opening]):hover .card,
  .box:not([data-opening]):focus-visible .card {
    transform: translate(-50%, -64%) translateZ(2px);
  }

  /* Opening: the lid flies off and the view dives through the acrylic toward the work. */
  .box[data-opening] .lid {
    transform: translate(-50%, -50%) rotateX(90deg) translateZ(calc(var(--H) / 2 + 70cqw)) rotateY(25deg);
    opacity: 0;
  }
  .box[data-opening] .cube {
    transition: transform 900ms cubic-bezier(0.6, 0, 0.2, 1);
    transform: rotateX(0deg) rotateY(0deg) translateZ(320px) scale(1.6);
  }
  .box[data-opening] .label {
    opacity: 0;
    transition: opacity 200ms;
  }

  .label {
    display: flex;
    gap: 10px;
    text-align: center;
  }
  .num {
    color: var(--muted);
  }
</style>
