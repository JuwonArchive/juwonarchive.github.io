---
/**
 * Home 2D animation: an electron-shell diagram. One shell per archive (numbered like K, L, M, N),
 * its electrons labelled with that work's tools; a shimmering 2D sphere sits in the nucleus.
 */
import type { Work } from '../lib/site-schema';

interface Props {
  works: Work[];
}
const { works } = Astro.props;
const ascii = (t: string) => /^[\x20-\x7E]+$/.test(t);
const R0 = 150;
const STEP = Math.min(80, 330 / Math.max(works.length, 1));
const shells = works.map((w, i) => {
  const r = R0 + i * STEP;
  const tags = w.tags.filter(ascii).slice(0, 8);
  const labels = tags.length ? tags : [''];
  const offset = i * 23; // stagger so electrons never line up across shells
  return {
    r,
    num: String(i + 1).padStart(2, '0'),
    dur: 70 + i * 28,
    dir: i % 2 ? 'reverse' : 'normal',
    electrons: labels.map((label, k) => {
      const a = ((offset + (360 / labels.length) * k) * Math.PI) / 180;
      return { x: Math.cos(a) * r, y: Math.sin(a) * r, label };
    }),
  };
});
const outer = R0 + (works.length - 1) * STEP + 70;
---

<svg class="orbit" data-orbit viewBox={`${-outer} ${-outer} ${outer * 2} ${outer * 2}`} aria-hidden="true">
  <defs>
    <!-- Soft edge: the sphere fades out over a few pixels instead of a hard outline. -->
    <filter id="edge-soft" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="3.5"></feGaussianBlur></filter>
    <mask id="sphere-edge" maskUnits="userSpaceOnUse" x="-90" y="-90" width="180" height="180">
      <circle r="69" fill="#fff" filter="url(#edge-soft)"></circle>
    </mask>
    <!-- Vivid glass sphere: deep blue body, flowing light bands, dark rim, white crescent. -->
    <radialGradient id="sphere-body" cx="50%" cy="50%" r="50%" fx="38%" fy="62%">
      <stop offset="0%" stop-color="#4aa8ff"></stop>
      <stop offset="50%" stop-color="#2546f2"></stop>
      <stop offset="100%" stop-color="#3a1bd0"></stop>
    </radialGradient>
    <linearGradient id="bands" x1="0" y1="0" x2="1" y2="0" gradientUnits="objectBoundingBox" spreadMethod="repeat" gradientTransform="rotate(32 .5 .5) scale(.27 1)">
      <stop offset="0" stop-color="#3b1fd8" stop-opacity=".85"></stop>
      <stop offset=".28" stop-color="#1e6bff" stop-opacity=".9"></stop>
      <stop offset=".42" stop-color="#4fd0ff" stop-opacity="1"></stop>
      <stop offset=".5" stop-color="#f2fbff" stop-opacity="1"></stop>
      <stop offset=".6" stop-color="#4fd0ff" stop-opacity=".95"></stop>
      <stop offset=".78" stop-color="#1e6bff" stop-opacity=".9"></stop>
      <stop offset="1" stop-color="#3b1fd8" stop-opacity=".85"></stop>
      <animateTransform attributeName="gradientTransform" type="translate" additive="sum" values="0 0; 1 0" dur="4.5s" repeatCount="indefinite"></animateTransform>
    </linearGradient>
    <filter id="ripple" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.009 0.02" numOctaves="1" seed="3">
        <animate attributeName="baseFrequency" values="0.008 0.018;0.011 0.024;0.008 0.018" dur="7s" repeatCount="indefinite"></animate>
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="60" xChannelSelector="R" yChannelSelector="G" result="waves">
        <animate attributeName="scale" values="48;76;48" dur="6s" repeatCount="indefinite"></animate>
      </feDisplacementMap>
      <!-- Hazy but vivid: soft bands with their own bloom screened on top. -->
      <feGaussianBlur in="waves" stdDeviation="4.5" result="soft"></feGaussianBlur>
      <feGaussianBlur in="waves" stdDeviation="12" result="bloom"></feGaussianBlur>
      <feBlend in="soft" in2="bloom" mode="screen"></feBlend>
    </filter>
    <radialGradient id="sphere-shade" cx="50%" cy="50%" r="50%">
      <stop offset="70%" stop-color="#1a0a6a" stop-opacity="0"></stop>
      <stop offset="100%" stop-color="#1a0a6a" stop-opacity=".3"></stop>
    </radialGradient>
    <linearGradient id="specular" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff" stop-opacity=".35"></stop>
      <stop offset="45%" stop-color="#ffffff" stop-opacity="1"></stop>
      <stop offset="75%" stop-color="#e6f6ff" stop-opacity=".75"></stop>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0"></stop>
    </linearGradient>
    <!-- Crescent = the sphere minus the same disc shifted down-left. -->
    <mask id="crescent" maskUnits="userSpaceOnUse" x="-80" y="-80" width="160" height="160">
      <circle r="72" fill="#fff"></circle>
      <circle cx="-18" cy="16" r="72" fill="#000" filter="url(#mask-soft)"></circle>
    </mask>
    <filter id="mask-soft" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="7"></feGaussianBlur></filter>
    <filter id="crescent-soft" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="6"></feGaussianBlur></filter>
    <radialGradient id="sphere-glow">
      <stop offset="0%" stop-color="#22c8ff" stop-opacity=".95"></stop>
      <stop offset="45%" stop-color="#1e7bff" stop-opacity=".45"></stop>
      <stop offset="100%" stop-color="#1e7bff" stop-opacity="0"></stop>
    </radialGradient>
    <filter id="soft-glow" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="20"></feGaussianBlur></filter>
  </defs>

  <g data-sphere>
    <circle class="glow" data-glow cx="-14" cy="18" r="150" fill="url(#sphere-glow)" filter="url(#soft-glow)"></circle>
    <g data-body mask="url(#sphere-edge)">
      <circle r="72" fill="url(#sphere-body)"></circle>
      <rect data-bands x="-110" y="-110" width="220" height="220" fill="url(#bands)" filter="url(#ripple)"></rect>
      <circle r="72" fill="url(#sphere-shade)"></circle>
      <!-- Bright white crescent along the upper-right edge. -->
      <rect data-specular x="-72" y="-72" width="144" height="144" fill="url(#specular)" mask="url(#crescent)" filter="url(#crescent-soft)"></rect>
    </g>
  </g>

  {
    shells.map((s) => (
      <g class="shell" style={`--dur:${s.dur}s;--dir:${s.dir}`}>
        <circle class="ring" r={s.r} />
        {s.electrons.map((e) => (
          <g data-electron>
            <circle class="electron" cx={e.x} cy={e.y} r="7" />
            {e.label && (
              // Pinned to its dot and turned back as the shell turns, so the label keeps
              // the same on-screen offset (to the right of the dot) and never covers it.
              <g class="tag" style={`transform-origin:${e.x}px ${e.y}px`}>
                <text x={e.x + 14} y={e.y} dominant-baseline="middle">
                  {e.label}
                </text>
              </g>
            )}
          </g>
        ))}
      </g>
    ))
  }

  {
    shells.map((s) => (
      <text class="shell-num" x="0" y={s.r - 10} text-anchor="middle">
        {s.num}
      </text>
    ))
  }
</svg>

<script>
  // SMIL animations ignore CSS media queries; pause them for reduced-motion visitors.
  const svg = document.querySelector<SVGSVGElement>('[data-orbit]');
  if (svg && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    svg.pauseAnimations();
    svg.setCurrentTime(0);
  }
</script>

<style>
  .orbit {
    width: min(86vmin, 820px);
    height: auto;
    overflow: visible;
  }
  .ring {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
    opacity: 0.55;
  }
  .electron {
    fill: var(--ink);
  }
  text {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.04em;
    fill: var(--ink);
  }
  .shell-num {
    font-size: 13px;
    fill: var(--muted);
  }
  .shell {
    transform-origin: 0 0;
    animation: spin var(--dur) linear infinite;
    animation-direction: var(--dir);
  }
  /* Labels turn back as their shell turns, so they always read upright. */
  .tag {
    animation: spin var(--dur) linear infinite;
    animation-direction: var(--dir);
    animation-name: spin-back;
  }
  .glow {
    transform-origin: 0 0;
    animation: breathe 6s ease-in-out infinite alternate;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes spin-back {
    to {
      transform: rotate(-360deg);
    }
  }
  @keyframes breathe {
    from {
      opacity: 0.65;
      transform: scale(0.85);
    }
    to {
      opacity: 1;
      transform: scale(1.18);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shell,
    .tag,
    .glow {
      animation: none;
    }
  }
  @media (max-width: 767px) {
    text {
      font-size: 22px;
    }
    .shell-num {
      font-size: 18px;
    }
  }
</style>
