---
/**
 * Home 2D animation: an electron-shell diagram. One shell per archive (numbered like K, L, M, N),
 * its electrons labelled with that work's tools; a shimmering 2D sphere sits in the nucleus.
 */
import type { Work } from '../lib/site-schema';

interface Props {
  works: Work[];
}
const { works } = Astro.props;
const ascii = (t: string) => /^[\x20-\x7E]+$/.test(t);
const R0 = 150;
const STEP = Math.min(80, 330 / Math.max(works.length, 1));
const shells = works.map((w, i) => {
  const r = R0 + i * STEP;
  const tags = w.tags.filter(ascii).slice(0, 8);
  const labels = tags.length ? tags : [''];
  const offset = i * 23; // stagger so electrons never line up across shells
  return {
    r,
    num: String(i + 1).padStart(2, '0'),
    dur: 70 + i * 28,
    dir: i % 2 ? 'reverse' : 'normal',
    electrons: labels.map((label, k) => {
      const a = ((offset + (360 / labels.length) * k) * Math.PI) / 180;
      return { x: Math.cos(a) * r, y: Math.sin(a) * r, label };
    }),
  };
});
const outer = R0 + (works.length - 1) * STEP + 70;
---

<svg class="orbit" data-orbit viewBox={`${-outer} ${-outer} ${outer * 2} ${outer * 2}`} aria-hidden="true">
  <defs>
    <!-- Sphere body: off-centre highlight, colour drifting lavender → mint → pink. -->
    <radialGradient id="sphere-body" cx="50%" cy="50%" r="50%" fx="34%" fy="30%">
      <stop offset="0%" stop-color="#ffffff"></stop>
      <stop offset="22%" stop-color="#e6fbf6">
        <animate attributeName="stop-color" values="#e6fbf6;#efe9ff;#ffe9f5;#e6fbf6" dur="9s" repeatCount="indefinite"></animate>
      </stop>
      <stop offset="62%" stop-color="#c9bcff">
        <animate attributeName="stop-color" values="#c9bcff;#9ff0d6;#ffb3dc;#c9bcff" dur="9s" repeatCount="indefinite"></animate>
      </stop>
      <stop offset="100%" stop-color="#a99cf0">
        <animate attributeName="stop-color" values="#a99cf0;#7fd8c0;#f29ac9;#a99cf0" dur="9s" repeatCount="indefinite"></animate>
      </stop>
    </radialGradient>
    <radialGradient id="sphere-glow">
      <stop offset="0%" stop-color="#d8cdff" stop-opacity="0.9"></stop>
      <stop offset="55%" stop-color="#bff6ec" stop-opacity="0.45"></stop>
      <stop offset="100%" stop-color="#ffc9e8" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="sphere-rim" cx="50%" cy="50%" r="50%">
      <stop offset="78%" stop-color="#ffffff" stop-opacity="0"></stop>
      <stop offset="100%" stop-color="#6f64b8" stop-opacity="0.28"></stop>
    </radialGradient>
    <!-- Liquid wobble: animated turbulence displaces the sphere's edge. -->
    <filter id="wobble" x="-30%" y="-30%" width="160%" height="160%">
      <feTurbulence type="fractalNoise" baseFrequency="0.012" numOctaves="2" seed="4" result="noise">
        <animate attributeName="baseFrequency" values="0.010;0.018;0.012;0.010" dur="7s" repeatCount="indefinite"></animate>
        <animate attributeName="seed" values="4;5;6;7;8" dur="10s" repeatCount="indefinite"></animate>
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="16" xChannelSelector="R" yChannelSelector="G">
        <animate attributeName="scale" values="10;22;14;10" dur="5s" repeatCount="indefinite"></animate>
      </feDisplacementMap>
    </filter>
    <filter id="glow-wobble" x="-60%" y="-60%" width="220%" height="220%">
      <feTurbulence type="fractalNoise" baseFrequency="0.008" numOctaves="2" seed="2">
        <animate attributeName="baseFrequency" values="0.006;0.012;0.008;0.006" dur="8s" repeatCount="indefinite"></animate>
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="40" xChannelSelector="R" yChannelSelector="B"></feDisplacementMap>
      <feGaussianBlur stdDeviation="16"></feGaussianBlur>
    </filter>
  </defs>

  <g data-sphere>
    <circle class="glow" r="150" fill="url(#sphere-glow)" filter="url(#glow-wobble)"></circle>
    <g filter="url(#wobble)">
      <circle r="64" fill="url(#sphere-body)"></circle>
      <circle r="64" fill="url(#sphere-rim)"></circle>
      <ellipse cx="-22" cy="-26" rx="16" ry="10" fill="#ffffff" opacity="0.85" transform="rotate(-30 -22 -26)"></ellipse>
    </g>
  </g>

  {
    shells.map((s) => (
      <g class="shell" style={`--dur:${s.dur}s;--dir:${s.dir}`}>
        <circle class="ring" r={s.r} />
        {s.electrons.map((e) => (
          <g data-electron>
            <circle class="electron" cx={e.x} cy={e.y} r="7" />
            {e.label && (
              // Pinned to its dot and turned back as the shell turns, so the label keeps
              // the same on-screen offset (to the right of the dot) and never covers it.
              <g class="tag" style={`transform-origin:${e.x}px ${e.y}px`}>
                <text x={e.x + 14} y={e.y} dominant-baseline="middle">
                  {e.label}
                </text>
              </g>
            )}
          </g>
        ))}
      </g>
    ))
  }

  {
    shells.map((s) => (
      <text class="shell-num" x="0" y={s.r - 10} text-anchor="middle">
        {s.num}
      </text>
    ))
  }
</svg>

<script>
  // SMIL animations ignore CSS media queries; pause them for reduced-motion visitors.
  const svg = document.querySelector<SVGSVGElement>('[data-orbit]');
  if (svg && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    svg.pauseAnimations();
    svg.setCurrentTime(0);
  }
</script>

<style>
  .orbit {
    width: min(86vmin, 820px);
    height: auto;
    overflow: visible;
  }
  .ring {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
    opacity: 0.55;
  }
  .electron {
    fill: var(--ink);
  }
  text {
    /* A thin page-coloured halo keeps labels readable where they cross a ring. */
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 5px;
    stroke-linejoin: round;
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.04em;
    fill: var(--ink);
  }
  .shell-num {
    font-size: 13px;
    fill: var(--muted);
  }
  .shell {
    transform-origin: 0 0;
    animation: spin var(--dur) linear infinite;
    animation-direction: var(--dir);
  }
  /* Labels turn back as their shell turns, so they always read upright. */
  .tag {
    animation: spin var(--dur) linear infinite;
    animation-direction: var(--dir);
    animation-name: spin-back;
  }
  .glow {
    transform-origin: 0 0;
    animation: breathe 6s ease-in-out infinite alternate;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes spin-back {
    to {
      transform: rotate(-360deg);
    }
  }
  @keyframes breathe {
    from {
      opacity: 0.65;
      transform: scale(0.85);
    }
    to {
      opacity: 1;
      transform: scale(1.18);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shell,
    .tag,
    .glow {
      animation: none;
    }
  }
  @media (max-width: 767px) {
    text {
      font-size: 22px;
    }
    .shell-num {
      font-size: 18px;
    }
  }
</style>
