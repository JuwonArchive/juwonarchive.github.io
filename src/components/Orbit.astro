---
/**
 * Home 2D animation: an electron-shell diagram. One shell per archive (numbered like K, L, M, N),
 * its electrons labelled with that work's tools; a soft pastel core sits in the nucleus.
 */
import type { Work } from '../lib/site-schema';

interface Props {
  works: Work[];
}
const { works } = Astro.props;
const ascii = (t: string) => /^[\x20-\x7E]+$/.test(t);
const R0 = 150;
const STEP = Math.min(80, 330 / Math.max(works.length, 1));
const shells = works.map((w, i) => {
  const r = R0 + i * STEP;
  const tags = w.tags.filter(ascii).slice(0, 8);
  const labels = tags.length ? tags : [''];
  const offset = i * 23; // stagger so electrons never line up across shells
  return {
    r,
    num: String(i + 1).padStart(2, '0'),
    dur: 70 + i * 28,
    dir: i % 2 ? 'reverse' : 'normal',
    electrons: labels.map((label, k) => {
      const a = ((offset + (360 / labels.length) * k) * Math.PI) / 180;
      return { x: Math.cos(a) * r, y: Math.sin(a) * r, label };
    }),
  };
});
const outer = R0 + (works.length - 1) * STEP + 70;
---

<svg class="orbit" data-orbit viewBox={`${-outer} ${-outer} ${outer * 2} ${outer * 2}`} aria-hidden="true">
  <defs>
    <radialGradient id="core">
      <stop offset="0%" stop-color="#bff6ec" stop-opacity="0.95"></stop>
      <stop offset="45%" stop-color="#d8cdff" stop-opacity="0.7"></stop>
      <stop offset="75%" stop-color="#ffc9e8" stop-opacity="0.35"></stop>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0"></stop>
    </radialGradient>
    <filter id="soft" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="14"></feGaussianBlur></filter>
  </defs>

  <circle class="core" r="120" fill="url(#core)" filter="url(#soft)"></circle>
  <circle class="nucleus" r="46" fill="none"></circle>

  {
    shells.map((s) => (
      <g class="shell" style={`--dur:${s.dur}s;--dir:${s.dir}`}>
        <circle class="ring" r={s.r} />
        {s.electrons.map((e) => (
          <g data-electron>
            <circle class="electron" cx={e.x} cy={e.y} r="7" />
            {e.label && (
              // Pinned to its dot and turned back as the shell turns, so the label keeps
              // the same on-screen offset (to the right of the dot) and never covers it.
              <g class="tag" style={`transform-origin:${e.x}px ${e.y}px`}>
                <text x={e.x + 14} y={e.y} dominant-baseline="middle">
                  {e.label}
                </text>
              </g>
            )}
          </g>
        ))}
      </g>
    ))
  }

  {
    shells.map((s) => (
      <text class="shell-num" x="0" y={s.r - 10} text-anchor="middle">
        {s.num}
      </text>
    ))
  }
</svg>

<style>
  .orbit {
    width: min(86vmin, 820px);
    height: auto;
    overflow: visible;
  }
  .ring {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
    opacity: 0.55;
  }
  .nucleus {
    stroke: var(--ink);
    stroke-width: 1;
    opacity: 0.35;
  }
  .electron {
    fill: var(--ink);
  }
  text {
    /* A thin page-coloured halo keeps labels readable where they cross a ring. */
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 5px;
    stroke-linejoin: round;
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.04em;
    fill: var(--ink);
  }
  .shell-num {
    font-size: 13px;
    fill: var(--muted);
  }
  .shell {
    transform-origin: 0 0;
    animation: spin var(--dur) linear infinite;
    animation-direction: var(--dir);
  }
  /* Labels turn back as their shell turns, so they always read upright. */
  .tag {
    animation: spin var(--dur) linear infinite;
    animation-direction: var(--dir);
    animation-name: spin-back;
  }
  .core {
    transform-origin: 0 0;
    animation: breathe 7s ease-in-out infinite alternate;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes spin-back {
    to {
      transform: rotate(-360deg);
    }
  }
  @keyframes breathe {
    from {
      opacity: 0.7;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1.06);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shell,
    .tag,
    .core {
      animation: none;
    }
  }
  @media (max-width: 767px) {
    text {
      font-size: 22px;
    }
    .shell-num {
      font-size: 18px;
    }
  }
</style>
