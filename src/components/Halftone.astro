---
/** Home artwork: 3D orbital line art read through a halftone screen, with crisp labelled line art on top. */
import { loadSite } from '../data/load';
// One marker per archive box, numbered and named like the box, leading to it (user: 1).
const markers = loadSite().works.map((w, i) => ({
  label: `${String(i + 1).padStart(2, '0')} ${w.titleEn}`.toUpperCase(),
  href: `/archive/${w.slug}`,
}));
---

<canvas class="halftone" data-halftone aria-hidden="true"></canvas>
<canvas class="trace" data-trace data-markers={JSON.stringify(markers)} aria-hidden="true"></canvas>
<!-- Desktop (user): live readout of the drawing, lab-instrument style. Decorative, so hidden from assistive tech. -->
<dl class="readout mono" data-readout aria-hidden="true">
  <div><dt>ORBIT 01</dt><dd data-ro="o0">—</dd></div>
  <div><dt>ORBIT 02</dt><dd data-ro="o1">—</dd></div>
  <div><dt>ORBIT 03</dt><dd data-ro="o2">—</dd></div>
  <div class="gap"><dt>CROSSINGS</dt><dd data-ro="crossings">—</dd></div>
  <div><dt>WAVES</dt><dd data-ro="waves">—</dd></div>
  <div><dt>LAST WAVE</dt><dd data-ro="last">—</dd></div>
  <div class="gap"><dt>VIEW</dt><dd data-ro="view">—</dd></div>
</dl>

<script>
  import { mountOrbitHalftone } from '../scripts/orbit-halftone';
  const dots = document.querySelector<HTMLCanvasElement>('canvas[data-halftone]');
  const lines = document.querySelector<HTMLCanvasElement>('canvas[data-trace]');
  const above = document.querySelector<HTMLElement>('.home .top');
  const below = document.querySelector<HTMLElement>('.home h1');
  const markers: { label: string; href: string }[] = JSON.parse(lines?.dataset.markers ?? '[]');
  if (dots) {
    mountOrbitHalftone({
      band: above && below ? { above, below } : null, // phones: sphere sits above JUWON (user: A)
      dots,
      lines,
      dotColor: '#ccd4dd', // a little darker (user)
      burstColor: '#8e9aa8', // bursts read at a glance
      lineColor: '#111111',
      labels: markers.map((m) => m.label),
      links: markers.map((m) => m.href),
      reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      mode: 'subtle', // faint along the orbits; the pointer reveals the halftone (user choice ③)
    });
  }
</script>

<script>
  // Fill the readout from the artwork's live state, a few times a second.
  const ro = document.querySelector<HTMLElement>('[data-readout]');
  const src = document.querySelector<HTMLCanvasElement>('canvas[data-halftone]');
  if (ro && src && matchMedia('(min-width: 768px)').matches) {
    const set = (k: string, v: string) => {
      const el = ro.querySelector<HTMLElement>(`[data-ro="${k}"]`);
      if (el && el.textContent !== v) el.textContent = v;
    };
    const fmt = (n: number) => (n >= 0 ? ' ' : '−') + Math.abs(n).toFixed(2);
    const update = () => {
      const d = src.dataset;
      (d.orbitDrift ?? '').split(' ').forEach((o, i) => {
        const [tilt, spin] = o.split('/').map(Number);
        if (Number.isFinite(tilt)) set(`o${i}`, `TILT${fmt(tilt)}  SPIN${fmt(((spin % (2 * Math.PI)) + 2 * Math.PI) % (2 * Math.PI))}`);
      });
      set('crossings', String(d.crossings ?? 0).padStart(2, '0'));
      set('waves', String(d.bursts ?? 0).padStart(2, '0'));
      set('last', d.lastStrength ? `S ${Number(d.lastStrength).toFixed(2)}` : '—');
      const [yaw] = (d.pose ?? '0,0').split(',').map(Number);
      set('view', `YAW${fmt(yaw)}  PITCH${fmt(Number(d.tilt ?? 0))}`);
    };
    update();
    setInterval(update, 200);
  }
</script>

<style>
  .halftone,
  .trace {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Soft halftone (like a screen print) under a crisp line drawing. */
  .halftone {
    z-index: 0;
  }
  .trace {
    z-index: 1;
    opacity: 0.9;
  }
  /* Live readout, right of the sphere: tiny muted mono, desktop only. */
  .readout {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    bottom: calc(50% + 24px); /* sits above the horizontal axis line */
    margin: 0;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.9;
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }
  .readout div {
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }
  .readout .gap {
    margin-top: 10px;
  }
  .readout dt {
    margin: 0;
  }
  .readout dd {
    margin: 0;
    color: var(--ink);
    white-space: pre;
  }
  @media (max-width: 767px) {
    .readout {
      display: none;
    }
  }
</style>
