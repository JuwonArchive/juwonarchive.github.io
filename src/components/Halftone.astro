---
/** Home artwork: 3D orbital line art read through a halftone screen, with crisp labelled line art on top. */
import { loadSite } from '../data/load';
// One marker per archive box, numbered and named like the box, leading to it (user: 1).
const markers = loadSite().works.map((w, i) => ({
  label: `${String(i + 1).padStart(2, '0')} ${w.titleEn}`.toUpperCase(),
  href: `/archive/${w.slug}`,
}));
---

<canvas class="halftone" data-halftone aria-hidden="true"></canvas>
<canvas class="trace" data-trace data-markers={JSON.stringify(markers)} aria-hidden="true"></canvas>

<script>
  import { mountOrbitHalftone } from '../scripts/orbit-halftone';
  const dots = document.querySelector<HTMLCanvasElement>('canvas[data-halftone]');
  const lines = document.querySelector<HTMLCanvasElement>('canvas[data-trace]');
  const above = document.querySelector<HTMLElement>('.home .top');
  const below = document.querySelector<HTMLElement>('.home h1');
  const markers: { label: string; href: string }[] = JSON.parse(lines?.dataset.markers ?? '[]');
  if (dots) {
    mountOrbitHalftone({
      band: above && below ? { above, below } : null, // phones: sphere sits above JUWON (user: A)
      dots,
      lines,
      dotColor: '#ccd4dd', // a little darker (user)
      lineColor: '#111111',
      labels: markers.map((m) => m.label),
      links: markers.map((m) => m.href),
      reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      mode: 'subtle', // faint along the orbits; the pointer reveals the halftone (user choice ③)
    });
  }
</script>

<style>
  .halftone,
  .trace {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Soft halftone (like a screen print) under a crisp line drawing. */
  .halftone {
    z-index: 0;
  }
  .trace {
    z-index: 1;
    opacity: 0.9;
  }
</style>
