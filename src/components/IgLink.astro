---
/** Corner button that opens the original Instagram post. */
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a class="pill ig-link" data-ig-link href={href} target="_blank" rel="noopener">INSTAGRAM ↗</a>

<style>
  .ig-link {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
  }
</style>
