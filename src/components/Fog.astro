---
/** Background fog: four soft palette clouds drifting slowly; each leans toward the pointer at its own depth. */
const layers = [
  { color: '#f0faff', x: 18, y: 22, size: 70, depth: 18, dur: 26 },
  { color: '#49c2ff', x: 78, y: 30, size: 58, depth: 34, dur: 22 },
  { color: '#4963fd', x: 64, y: 82, size: 64, depth: 26, dur: 30 },
  { color: '#443be3', x: 24, y: 76, size: 52, depth: 42, dur: 24 },
];
---

<div class="fog" data-fog aria-hidden="true">
  {
    layers.map((l, i) => (
      <div class="follow" style={`--x:${l.x}%;--y:${l.y}%;--depth:${l.depth}px`}>
        <span
          class="cloud"
          data-fog-layer={l.color}
          style={`--c:${l.color};--size:${l.size}vmax;--dur:${l.dur}s;--delay:${-i * 5}s`}
        />
      </div>
    ))
  }
</div>

<script>
  // Ease the pointer into --mx/--my (-1…1); each cloud multiplies it by its own depth.
  const fog = document.querySelector<HTMLElement>('[data-fog]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fog && !reduce) {
    const target = { x: 0, y: 0 };
    const cur = { x: 0, y: 0 };
    window.addEventListener(
      'pointermove',
      (e) => {
        target.x = (e.clientX / window.innerWidth) * 2 - 1;
        target.y = (e.clientY / window.innerHeight) * 2 - 1;
      },
      { passive: true },
    );
    const tick = () => {
      cur.x += (target.x - cur.x) * 0.06;
      cur.y += (target.y - cur.y) * 0.06;
      fog.style.setProperty('--mx', cur.x.toFixed(3));
      fog.style.setProperty('--my', cur.y.toFixed(3));
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>

<style>
  .fog {
    --mx: 0;
    --my: 0;
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .follow {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(calc(var(--mx) * var(--depth) * 3), calc(var(--my) * var(--depth) * 3));
  }
  .cloud {
    display: block;
    width: var(--size);
    aspect-ratio: 1;
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--c), transparent);
    filter: blur(40px);
    opacity: 0.28;
    animation: drift var(--dur) ease-in-out var(--delay) infinite alternate;
  }
  @keyframes drift {
    0% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(6vw, -4vh) scale(1.12);
    }
    66% {
      transform: translate(-5vw, 5vh) scale(0.92);
    }
    100% {
      transform: translate(3vw, 2vh) scale(1.05);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cloud {
      animation: none;
    }
  }
</style>
