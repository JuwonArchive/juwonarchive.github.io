---
/** Inner-page top bar. Home has its own bottom-right nav (spec §11). */
interface Props {
  current?: 'archive' | 'info' | 'item';
}
const { current } = Astro.props;
---

<header class="nav">
  {
    current === 'item' ? (
      <a class="pill" href="/archive">
        ← ARCHIVE
      </a>
    ) : (
      <a class="brand mono" href="/">
        JUWON
      </a>
    )
  }
  {
    current === 'item' && (
      <a class="brand mono center" href="/">
        JUWON
      </a>
    )
  }
  <nav aria-label="Main">
    {
      current !== 'item' && (
        <a class="pill" href="/archive" aria-current={current === 'archive' ? 'page' : undefined}>
          ARCHIVE
        </a>
      )
    }
    <a class="pill" href="/info" aria-current={current === 'info' ? 'page' : undefined}>INFO</a>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: var(--gutter);
    pointer-events: none;
  }
  .nav > * {
    pointer-events: auto;
  }
  .brand {
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.08em;
  }
  .center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  nav {
    display: flex;
    gap: 6px;
  }
</style>
