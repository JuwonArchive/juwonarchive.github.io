---
/** Floating chrome object. Falls back to a still render when WebGL is unavailable. */
---

<div class="chrome" data-chrome>
  <canvas id="chrome-hero"></canvas>
  <img class="fallback" src="/chrome-fallback.webp" alt="" width="900" height="900" hidden />
  <noscript><img class="fallback" src="/chrome-fallback.webp" alt="" width="900" height="900" /></noscript>
</div>

<script>
  import { mountChromeHero } from '../scripts/chrome-hero';

  const canvas = document.querySelector<HTMLCanvasElement>('#chrome-hero');
  const fallback = document.querySelector<HTMLImageElement>('[data-chrome] img.fallback');
  if (canvas) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hero = mountChromeHero(canvas, { reducedMotion });
    if (!hero) {
      canvas.remove();
      fallback?.removeAttribute('hidden');
    } else {
      canvas.toggleAttribute('data-ready', true);
    }
  }
</script>

<style>
  .chrome {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  canvas {
    width: 100%;
    height: 100%;
  }
  .fallback {
    width: min(62vmin, 640px);
    height: auto;
  }
</style>
