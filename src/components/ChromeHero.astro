---
/** Floating chrome object. Falls back to a still render when WebGL is unavailable. */
---

<div class="chrome" data-chrome>
  <div class="aura" data-aura aria-hidden="true"><span class="rays"></span><span class="core"></span></div>
  <canvas id="chrome-hero"></canvas>
  <img class="fallback" src="/chrome-fallback.webp" alt="" width="900" height="900" hidden />
  <noscript><img class="fallback" src="/chrome-fallback.webp" alt="" width="900" height="900" /></noscript>
</div>

<script>
  import { mountChromeHero } from '../scripts/chrome-hero';

  const canvas = document.querySelector<HTMLCanvasElement>('#chrome-hero');
  const fallback = document.querySelector<HTMLImageElement>('[data-chrome] img.fallback');
  if (canvas) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hero = mountChromeHero(canvas, { reducedMotion });
    if (!hero) {
      canvas.remove();
      fallback?.removeAttribute('hidden');
    } else {
      canvas.toggleAttribute('data-ready', true);
    }
  }
</script>

<style>
  .chrome {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  canvas,
  .fallback {
    position: relative;
    z-index: 1;
  }
  canvas {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
  }
  /* Light leaking out of the object: soft pastel rays and a pale core, slowly turning. Kept quiet on purpose. */
  .aura {
    grid-area: 1 / 1;
    position: relative;
    z-index: 0;
    width: min(92vmin, 980px);
    aspect-ratio: 1;
    pointer-events: none;
  }
  .rays,
  .core {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  .rays {
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      rgba(157, 134, 255, 0.55) 14deg,
      transparent 30deg,
      transparent 52deg,
      rgba(95, 242, 184, 0.45) 66deg,
      transparent 82deg,
      transparent 112deg,
      rgba(255, 122, 200, 0.5) 128deg,
      transparent 144deg,
      transparent 172deg,
      rgba(127, 211, 255, 0.45) 186deg,
      transparent 202deg,
      transparent 232deg,
      rgba(157, 134, 255, 0.5) 248deg,
      transparent 264deg,
      transparent 292deg,
      rgba(255, 122, 200, 0.45) 308deg,
      transparent 324deg
    );
    -webkit-mask-image: radial-gradient(closest-side, transparent 14%, #000 26%, rgba(0, 0, 0, 0.5) 60%, transparent 100%);
    mask-image: radial-gradient(closest-side, transparent 14%, #000 26%, rgba(0, 0, 0, 0.5) 60%, transparent 100%);
    filter: blur(12px);
    opacity: 0.85;
    animation: turn 60s linear infinite;
  }
  .core {
    inset: 22%;
    background: radial-gradient(closest-side, rgba(170, 245, 236, 0.85), rgba(201, 190, 255, 0.45) 55%, transparent 100%);
    filter: blur(24px);
    animation: breathe 7s ease-in-out infinite alternate;
  }
  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes breathe {
    from {
      opacity: 0.55;
      transform: scale(0.94);
    }
    to {
      opacity: 0.85;
      transform: scale(1.04);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rays,
    .core {
      animation: none;
    }
  }
  .fallback {
    grid-area: 1 / 1;
    width: min(62vmin, 640px);
    height: auto;
  }
</style>
