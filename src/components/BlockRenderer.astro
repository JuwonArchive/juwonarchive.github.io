---
import type { Block } from '../lib/site-schema';
import RichText from './RichText.astro';
import { igCrop } from '../lib/ig-crop';

interface Props {
  blocks: Block[];
  title: string;
}
const { blocks, title } = Astro.props;
let firstImage = true;
const isFirstImage = () => {
  const v = firstImage;
  firstImage = false;
  return v;
};
---

<div class="blocks">
  {
    blocks.map((b) => {
      switch (b.type) {
        case 'heading': {
          const H = (`h${b.level + 1}`) as 'h2' | 'h3' | 'h4';
          return (
            <H class="b-heading text">
              <RichText text={b.text} />
            </H>
          );
        }
        case 'paragraph':
          return (
            <p class="b-text text">
              <RichText text={b.text} />
            </p>
          );
        case 'quote':
          return (
            <blockquote class="b-quote text">
              <RichText text={b.text} />
            </blockquote>
          );
        case 'list': {
          const L = b.ordered ? 'ol' : 'ul';
          return (
            <L class="b-list text">
              {b.items.map((item) => (
                <li>
                  <RichText text={item} />
                </li>
              ))}
            </L>
          );
        }
        case 'divider':
          return <hr class="b-divider" />;
        case 'image': {
          const first = isFirstImage();
          // Detail-page style images (more than 2× taller than wide) show their top at full width.
          const tall = !!(b.media.width && b.media.height && b.media.height > b.media.width * 2);
          return (
            <figure class="b-media">
              <a
                class="frame"
                data-frame
                data-tall={tall ? '' : undefined}
                href={b.media.src}
                target="_blank"
                rel="noopener"
                aria-label="Open full-size image"
                style={tall ? `--natural-w:${b.media.width}px` : undefined}
              >
                <img
                  src={b.media.src}
                  width={b.media.width}
                  height={b.media.height}
                  alt={b.caption ? b.caption.map((s) => s.text).join('') : ''}
                  loading={first ? 'eager' : 'lazy'}
                  fetchpriority={first ? 'high' : undefined}
                  decoding="async"
                />
                {tall && <span class="mono view-full">VIEW FULL ↗</span>}
              </a>
              {(b.caption || b.source) && (
                <figcaption class="mono">
                  {b.caption && <RichText text={b.caption} />}
                  {b.source && (
                    <a class="source" href={b.source} target="_blank" rel="noopener">
                      OPEN ON INSTAGRAM ↗
                    </a>
                  )}
                </figcaption>
              )}
            </figure>
          );
        }
        case 'video':
          return (
            <figure class="b-media">
              <div class="frame" data-frame>
                <video src={b.media.src} muted playsinline loop controls preload="metadata" data-inview-play />
              </div>
              {(b.caption || b.source) && (
                <figcaption class="mono">
                  {b.caption && <RichText text={b.caption} />}
                  {b.source && (
                    <a class="source" href={b.source} target="_blank" rel="noopener">
                      OPEN ON INSTAGRAM ↗
                    </a>
                  )}
                </figcaption>
              )}
            </figure>
          );
        case 'embed': {
          const iframe = (
            <iframe
              src={b.embedUrl}
              title={`${title} — ${b.provider} embed`}
              loading="lazy"
              allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
              scrolling="no"
            />
          );
          const sizedInstagram = b.provider === 'instagram' && b.aspect;
          return (
            <figure class={`b-embed b-embed--${b.provider}`}>
              {sizedInstagram ? (
                <div class="frame" data-frame>
                  <div
                    class="ig-crop"
                    data-ig-crop
                    data-w={igCrop(b.aspect!).width}
                    data-h={igCrop(b.aspect!).height}
                    style={`--crop-w:${igCrop(b.aspect!).width}px;--crop-h:${igCrop(b.aspect!).height}px;--off-x:${igCrop(b.aspect!).offsetX}px`}
                  >
                    {iframe}
                  </div>
                </div>
              ) : (
                <div class={`frame${b.provider === 'instagram' ? ' frame--portrait' : ''}`} data-frame>
                  {iframe}
                </div>
              )}
              <figcaption class="mono">
                <a href={b.url} target="_blank" rel="noopener">
                  OPEN ON {b.provider.toUpperCase()} ↗
                </a>
              </figcaption>
            </figure>
          );
        }
        case 'fallback-link':
          return (
            <p class="b-fallback">
              <a class="pill" href={b.url} target="_blank" rel="noopener">
                {b.label} ↗
              </a>
            </p>
          );
      }
    })
  }
</div>

<script>
  // Instagram embeds render at a natural 400px width and are scaled into the 16:9 frame.
  // Sized posts are cropped to the post itself (Instagram's header and footer stay hidden);
  // unsized ones fall back to the whole embed scaled to the frame height.
  const NATURAL_H = 720;
  const fit = (frame: HTMLElement) => {
    const crop = frame.querySelector<HTMLElement>('[data-ig-crop]');
    if (crop) {
      const scale = Math.min(frame.clientWidth / Number(crop.dataset.w), frame.clientHeight / Number(crop.dataset.h));
      crop.style.setProperty('--embed-scale', String(scale));
    } else {
      frame.style.setProperty('--embed-scale', String(frame.clientHeight / NATURAL_H));
    }
  };
  const frames = document.querySelectorAll<HTMLElement>('.frame--portrait, .frame:has([data-ig-crop])');
  const ro = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target as HTMLElement)));
  frames.forEach((el) => {
    fit(el);
    ro.observe(el);
  });
</script>

<script>
  // Play muted loops only while they are on screen; saves data and battery on phones.
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-inview-play]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { threshold: 0.25 },
    );
    videos.forEach((v) => {
      v.muted = true;
      io.observe(v);
    });
  }
</script>

<style>
  .blocks {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .text {
    width: 100%;
    max-width: 680px;
    margin: 0;
  }
  .b-heading {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.4;
    margin-top: 24px;
  }
  .b-quote {
    padding-left: 16px;
    border-left: 2px solid var(--ink);
  }
  .b-list {
    padding-left: 1.2em;
  }
  .b-divider {
    width: 100%;
    max-width: 1280px;
    border: 0;
    border-top: 1px solid var(--line);
    margin: 40px 0;
  }
  .b-media,
  .b-embed {
    width: 100%;
    max-width: 1280px;
    margin: 0;
  }
  /* One frame for every post: 16:9, at most 1280×720. The work is shown whole, never cropped. */
  .frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: rgba(0, 0, 0, 0.04);
  }
  .frame {
    display: grid;
    place-items: center;
  }
  /* Images keep their own pixel size as the upper bound so small files are never stretched (blurred). */
  .frame img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .frame[data-tall] img {
    width: min(100%, var(--natural-w));
    height: 100%;
    max-height: none;
    object-fit: cover;
    object-position: 50% 0%;
    align-self: start;
  }
  .view-full {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 6px 10px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
  }
  .frame video,
  .frame iframe {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border: 0;
  }
  a.frame {
    cursor: zoom-in;
  }
  .frame--portrait iframe {
    position: absolute;
    top: 0;
    left: 50%;
    width: 400px;
    height: 720px;
    transform-origin: top center;
    transform: translateX(-50%) scale(var(--embed-scale, 1));
    background: var(--white);
  }
  /* Crop window = the post only. The embed's 54px profile header sits above it and its footer below. */
  .ig-crop {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--crop-w);
    height: var(--crop-h);
    overflow: hidden;
    transform: translate(-50%, -50%) scale(var(--embed-scale, 1));
  }
  .frame .ig-crop iframe {
    position: absolute;
    top: -54px;
    left: calc(-1 * var(--off-x));
    width: 400px;
    max-width: none;
    /* Same viewport the crop numbers were measured in; Instagram sizes media by viewport. */
    height: 900px;
    object-fit: initial;
  }
  figcaption {
    padding-top: 8px;
    color: var(--muted);
  }
  figcaption a {
    text-decoration: none;
  }
  figcaption .source {
    display: inline-block;
    margin-left: 12px;
  }
  figcaption .source:first-child {
    margin-left: 0;
  }
  figcaption a:hover {
    color: var(--ink);
  }
  .b-fallback {
    margin: 0;
  }
</style>
