---
import type { Block } from '../lib/site-schema';
import RichText from './RichText.astro';
import { igCrop } from '../lib/ig-crop';
import CropMarks from './CropMarks.astro';
import IgLink from './IgLink.astro';

interface Props {
  blocks: Block[];
  title: string;
}
const { blocks, title } = Astro.props;
let firstImage = true;
const isFirstImage = () => {
  const v = firstImage;
  firstImage = false;
  return v;
};
---

<div class="blocks">
  {
    blocks.map((b) => {
      switch (b.type) {
        case 'heading': {
          const H = (`h${b.level + 1}`) as 'h2' | 'h3' | 'h4';
          return (
            <H class="b-heading text">
              <RichText text={b.text} />
            </H>
          );
        }
        case 'paragraph':
          return (
            <p class="b-text text">
              <RichText text={b.text} />
            </p>
          );
        case 'quote':
          return (
            <blockquote class="b-quote text">
              <RichText text={b.text} />
            </blockquote>
          );
        case 'list': {
          const L = b.ordered ? 'ol' : 'ul';
          return (
            <L class="b-list text">
              {b.items.map((item) => (
                <li>
                  <RichText text={item} />
                </li>
              ))}
            </L>
          );
        }
        case 'divider':
          return <hr class="b-divider" />;
        case 'image': {
          const first = isFirstImage();
          const tiles = b.media.tiles;
          if (tiles && b.media.width && b.media.height) {
            // A tall image in pieces: stacked edge to edge, each loading only as it nears the screen.
            const overlap = `${((2 / b.media.width) * 100).toFixed(4)}%`;
            return (
              <figure class="b-media">
                <CropMarks>
                  <div class="frame" data-frame>
                    <div class="tiles" data-tiles data-w={b.media.width} data-h={b.media.height} style={`--tile-overlap:${overlap}`}>
                      {tiles.map((t, i) => (
                        <img
                          src={t.src}
                          width={b.media.width}
                          height={t.height}
                          alt={i === 0 && b.caption ? b.caption.map((s) => s.text).join('') : ''}
                          loading={first && i === 0 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                      ))}
                    </div>
                    {b.source && <IgLink href={b.source} />}
                  </div>
                </CropMarks>
                {b.caption && (
                  <figcaption class="mono">
                    <RichText text={b.caption} />
                  </figcaption>
                )}
              </figure>
            );
          }
          return (
            <figure class="b-media">
              <CropMarks>
                <div class="frame" data-frame>
                  <a
                    class={b.playOn ? 'zoom play' : 'zoom'}
                    href={b.playOn && b.source ? b.source : b.media.src}
                    target="_blank"
                    rel="noopener"
                    aria-label={b.playOn ? 'Play this video on Instagram' : 'Open full-size image'}
                    data-play-on={b.playOn}
                  >
                    <img
                      src={b.media.src}
                      width={b.media.width}
                      height={b.media.height}
                      alt={b.caption ? b.caption.map((s) => s.text).join('') : ''}
                      loading={first ? 'eager' : 'lazy'}
                      fetchpriority={first ? 'high' : undefined}
                      decoding="async"
                    />
                    {b.playOn && (
                      <span class="play-btn pill" aria-hidden="true">
                        ▶ PLAY ON INSTAGRAM
                      </span>
                    )}
                  </a>
                  {b.source && <IgLink href={b.source} />}
                </div>
              </CropMarks>
              {b.caption && (
                <figcaption class="mono">
                  <RichText text={b.caption} />
                </figcaption>
              )}
            </figure>
          );
        }
        case 'video':
          return (
            <figure class="b-media">
              <CropMarks>
                <div class="frame" data-frame>
                  {b.media.mobileSrc ? (
                    // Phones pick the lighter copy; the first matching <source> wins.
                    <video
                      width={b.media.width}
                      height={b.media.height}
                      muted
                      playsinline
                      loop
                      controls
                      preload="metadata"
                      data-inview-play
                    >
                      <source src={b.media.mobileSrc} type="video/mp4" media="(max-width: 767px)" />
                      <source src={b.media.src} type="video/mp4" />
                    </video>
                  ) : (
                    <video
                      src={b.media.src}
                      width={b.media.width}
                      height={b.media.height}
                      muted
                      playsinline
                      loop
                      controls
                      preload="metadata"
                      data-inview-play
                    />
                  )}
                  {b.source && <IgLink href={b.source} />}
                </div>
              </CropMarks>
              {b.caption && (
                <figcaption class="mono">
                  <RichText text={b.caption} />
                </figcaption>
              )}
            </figure>
          );
        case 'embed': {
          const iframe = (
            <iframe
              src={b.embedUrl}
              title={`${title} — ${b.provider} embed`}
              loading="lazy"
              allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
              scrolling="no"
            />
          );
          const ig = b.provider === 'instagram';
          const crop = ig && b.aspect ? igCrop(b.aspect) : null;
          // Frame takes the post's own shape: cropped Instagram post, full Instagram embed, or 16:9 player.
          const aspect = crop ? `${crop.width} / ${crop.height}` : ig ? '400 / 720' : '16 / 9';
          return (
            <figure class={`b-embed b-embed--${b.provider}`}>
              <CropMarks>
                <div class={`frame frame--embed${ig && !crop ? ' frame--portrait' : ''}`} data-frame style={`aspect-ratio:${aspect}`}>
                  {crop ? (
                    <div
                      class="ig-crop"
                      data-ig-crop
                      data-w={crop.width}
                      data-h={crop.height}
                      style={`--crop-w:${crop.width}px;--crop-h:${crop.height}px;--off-x:${crop.offsetX}px`}
                    >
                      {iframe}
                    </div>
                  ) : (
                    iframe
                  )}
                  {ig && <IgLink href={b.url} />}
                </div>
              </CropMarks>
              {!ig && (
                <figcaption class="mono">
                  <a href={b.url} target="_blank" rel="noopener">
                    OPEN ON {b.provider.toUpperCase()} ↗
                  </a>
                </figcaption>
              )}
            </figure>
          );
        }
        case 'fallback-link':
          return (
            <p class="b-fallback">
              <a class="pill" href={b.url} target="_blank" rel="noopener">
                {b.label} ↗
              </a>
            </p>
          );
      }
    })
  }
</div>

<script>
  // Instagram embeds render at a natural 400px width and are scaled to fill their frame,
  // which already has the post's own shape. Sized posts are cropped to the post itself.
  const NATURAL_H = 720;
  const fit = (frame: HTMLElement) => {
    const crop = frame.querySelector<HTMLElement>('[data-ig-crop]');
    if (crop) {
      const scale = Math.min(frame.clientWidth / Number(crop.dataset.w), frame.clientHeight / Number(crop.dataset.h));
      crop.style.setProperty('--embed-scale', String(scale));
    } else {
      frame.style.setProperty('--embed-scale', String(frame.clientHeight / NATURAL_H));
    }
  };
  const frames = document.querySelectorAll<HTMLElement>('.frame--portrait, .frame:has([data-ig-crop])');
  const ro = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target as HTMLElement)));
  frames.forEach((el) => {
    fit(el);
    ro.observe(el);
  });
</script>

<script>
  // Play muted loops only while they are on screen; saves data and battery on phones.
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-inview-play]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { threshold: 0.25 },
    );
    videos.forEach((v) => {
      v.muted = true;
      io.observe(v);
    });
  }
</script>

<style>
  .blocks {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .text {
    width: 100%;
    max-width: 680px;
    margin: 0;
  }
  .b-heading {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.4;
    margin-top: 24px;
  }
  .b-quote {
    padding-left: 16px;
    border-left: 2px solid var(--ink);
  }
  .b-list {
    padding-left: 1.2em;
  }
  .b-divider {
    width: 100%;
    max-width: var(--media-max);
    border: 0;
    border-top: 1px solid var(--line);
    margin: 40px 0;
  }
  .b-media,
  .b-embed {
    width: 100%;
    max-width: var(--media-max);
    margin: 0;
  }
  /* Every post is the same width (up to --media-max, 880px); height follows the work itself, never cropped. */
  .frame {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: rgba(0, 0, 0, 0.04);
  }
  .frame img,
  .frame video {
    display: block;
    width: 100%;
    height: auto;
  }
  .zoom {
    display: block;
    cursor: zoom-in;
  }
  /* Pieces of a tall image overlap by 2 source px (hidden by the negative margin) so no seam shows. */
  .tiles img + img {
    margin-top: calc(-1 * var(--tile-overlap));
  }
  /* Instagram withholds the video (e.g. library music): its cover, with a play button to the post (user). */
  .zoom.play {
    position: relative;
    cursor: pointer;
  }
  .play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    height: 40px;
    padding: 0 18px;
    pointer-events: none;
  }
  .zoom.play:hover .play-btn,
  .zoom.play:focus-visible .play-btn {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }
  .frame--embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .frame--portrait iframe {
    position: absolute;
    top: 0;
    left: 50%;
    width: 400px;
    height: 720px;
    transform-origin: top center;
    transform: translateX(-50%) scale(var(--embed-scale, 1));
    background: var(--white);
  }
  /* Crop window = the post only. The embed's 54px profile header sits above it and its footer below. */
  .ig-crop {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--crop-w);
    height: var(--crop-h);
    overflow: hidden;
    transform: translate(-50%, -50%) scale(var(--embed-scale, 1));
  }
  .frame .ig-crop iframe {
    position: absolute;
    top: -54px;
    left: calc(-1 * var(--off-x));
    width: 400px;
    max-width: none;
    /* Same viewport the crop numbers were measured in; Instagram sizes media by viewport. */
    height: 900px;
    object-fit: initial;
  }
  figcaption {
    padding-top: 8px;
    color: var(--muted);
  }
  figcaption a {
    text-decoration: none;
  }
  figcaption .source {
    display: inline-block;
    margin-left: 12px;
  }
  figcaption .source:first-child {
    margin-left: 0;
  }
  figcaption a:hover {
    color: var(--ink);
  }
  .b-fallback {
    margin: 0;
  }
</style>
