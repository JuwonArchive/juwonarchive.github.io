---
import Base from '../layouts/Base.astro';
import Orbit from '../components/Orbit.astro';
import Intro from '../components/Intro.astro';
import { config } from '../config';
import { longestWord } from '../lib/fit';
import { loadSite } from '../data/load';

const site = loadSite();
---

<Base title={config.homeTitle}>
  <main class="home">
    <Intro site={site} />
    <div class="hero-slot" aria-hidden="true"><Orbit works={site.works} /></div>
    <h1 class="display fit headline" style={`--chars:${longestWord(config.headline)}`} aria-label={config.headline}>
      {[...config.headline].map((ch, i) => <span class="l" style={`--i:${i}`} aria-hidden="true">{ch}</span>)}
    </h1>
    <div class="bar">
      <p class="mono subline" data-subline>{config.subline}</p>
      <nav class="ways" aria-label="Main" data-home-nav>
        <a class="pill" href="/archive">ARCHIVE</a>
        <a class="pill" href="/info">INFO</a>
      </nav>
    </div>
  </main>
</Base>

<style>
  .home {
    position: relative;
    height: 100svh;
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--gutter);
    overflow: hidden;
  }
  /* The diagram sits behind the name (user request). */
  .hero-slot {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .headline {
    position: relative;
    z-index: 1;
    pointer-events: none;
    /* JUWON's W and O are wider than average, so budget ~0.98em per glyph. */
    --fit-max: 360px;
    --fit-width: (100vw - 2 * var(--gutter)) * 0.86 / 0.98;
    margin-left: -0.04em;
  }
  .bar {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
  }
  .subline {
    margin: 0;
    max-width: 60ch;
  }
  .ways {
    display: flex;
    gap: 6px;
    margin-left: auto;
  }
</style>
