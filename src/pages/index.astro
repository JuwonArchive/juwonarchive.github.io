---
import Base from '../layouts/Base.astro';
import Halftone from '../components/Halftone.astro';
import Intro from '../components/Intro.astro';
import { config } from '../config';
import { longestWord } from '../lib/fit';
import { loadSite } from '../data/load';

const site = loadSite();
---

<Base title={config.homeTitle}>
  <main class="home">
    <Intro site={site} />
    <div class="hero-slot" aria-hidden="true"><Halftone /></div>
    <header class="top mono">
      <span data-corner-label>JUWON — PORTFOLIO ARCHIVE '26</span>
      <span class="clock">
        LOCAL <time data-visit-clock>--:--:--</time>
      </span>
    </header>
    <div class="spacer"></div>
    <h1 class="display fit headline" style={`--chars:${longestWord(config.headline)}`} aria-label={config.headline}>
      {[...config.headline].map((ch, i) => <span class="l" style={`--i:${i}`} aria-hidden="true">{ch}</span>)}
    </h1>
    <div class="bar">
      <p class="mono subline" data-subline>{config.subline}</p>
      <nav class="ways" aria-label="Main" data-home-nav>
        <a class="pill" href="/archive">ARCHIVE</a>
        <a class="pill" href="/info">INFO</a>
      </nav>
    </div>
  </main>
</Base>

<script>
  // Visitor's local time, ticking each second.
  const el = document.querySelector<HTMLTimeElement>('[data-visit-clock]');
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
    const tick = () => {
      const now = new Date();
      el.textContent = fmt.format(now);
      el.dateTime = now.toISOString();
    };
    tick();
    setInterval(tick, 1000);
  }
</script>

<style>
  .home {
    position: relative;
    height: 100svh;
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--gutter);
    overflow: hidden;
    /* The home does not scroll: a finger drag turns the sphere instead (user). */
    touch-action: none;
  }
  /* Halftone behind the name. */
  .hero-slot {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  /* Small top bar: label left, visitor's local time right — holds the page's structure. */
  .top {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--muted);
  }
  .top time {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .spacer {
    flex: 1;
  }
  .headline {
    position: relative;
    z-index: 2;
    pointer-events: none;
    /* JUWON's W and O are wider than average, so budget ~0.98em per glyph. */
    --fit-max: 360px;
    --fit-width: (100vw - 2 * var(--gutter)) * 0.86 / 0.98;
    text-align: center;
  }
  /* Phones (user): JUWON moves up under the top bar, like ARCHIVE on the archive page (still big and
     centred); the sphere takes the space below it. */
  @media (max-width: 767px) {
    .top {
      order: -2;
    }
    .headline {
      order: -1;
      margin: 20px 0 0;
    }
  }
  /* Desktop (user): JUWON sits top-left under the top bar, like ARCHIVE on the archive page,
     leaving the centre to the orbit graphic. */
  @media (min-width: 768px) {
    .headline {
      position: absolute;
      left: var(--gutter);
      top: calc(var(--gutter) + 40px);
      margin: 0;
      text-align: left;
      font-size: clamp(48px, 8vw, 132px); /* a little bigger (user) */
      line-height: 0.9;
    }
    .subline {
      max-width: 34ch;
    }
  }
  .bar {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
  }
  .subline {
    margin: 0;
    max-width: 60ch;
  }
  .ways {
    display: flex;
    gap: 6px;
    margin-left: auto;
  }
</style>
