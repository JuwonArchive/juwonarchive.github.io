---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ArchiveBox from '../../components/ArchiveBox.astro';
import { loadSite } from '../../data/load';
import { config } from '../../config';

const { works } = loadSite();
---

<Base title="ARCHIVE — JUWON" description="Archive of 3D, AI-generated and graphic work by JUWON.">
  <Nav slot="header" current="archive" />
  <main class="archive">
    <div class="title">
      <h1 class="display">ARCHIVE</h1>
      <span class="mono count" aria-label={`${works.length} archives`}>{String(works.length).padStart(2, '0')}</span>
    </div>
    <ul class="shelf" style={`--n:${works.length}`}>
      {
        works.map((w, i) => (
          <li>
            <ArchiveBox work={w} index={i} tint={config.pastels[i % config.pastels.length]} />
          </li>
        ))
      }
    </ul>
  </main>
  <div class="dive" data-dive aria-hidden="true"></div>
  <Footer slot="footer" />
</Base>

<script>
  // Click a box: lid opens, view dives in, screen fills with the box tint, then the page changes.
  const DIVE_MS = 850;
  const dive = document.querySelector<HTMLElement>('[data-dive]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  for (const box of document.querySelectorAll<HTMLAnchorElement>('a[data-archive-box]')) {
    box.addEventListener('click', (e) => {
      if (reduce.matches || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      if (box.hasAttribute('data-opening')) return;
      box.toggleAttribute('data-opening', true);
      dive?.style.setProperty('--dive-tint', box.style.getPropertyValue('--tint'));
      dive?.toggleAttribute('data-active', true);
      window.setTimeout(() => (window.location.href = box.href), DIVE_MS);
    });
  }
  // Coming back with the browser's back button restores the page from cache: reset it.
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    document.querySelectorAll('[data-opening]').forEach((el) => el.removeAttribute('data-opening'));
    dive?.removeAttribute('data-active');
  });
</script>

<style>
  .archive {
    min-height: calc(100svh - 60px);
    display: flex;
    flex-direction: column;
    padding: 96px var(--gutter) 32px;
  }
  .title {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .title h1 {
    font-size: clamp(48px, 12vw, 200px);
    margin-left: -0.04em;
  }
  .count {
    padding-top: 0.4em;
  }
  .shelf {
    --box-w: min(20vw, 260px);
    list-style: none;
    margin: auto 0;
    padding: 48px 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, var(--box-w)));
    justify-content: center;
    gap: clamp(16px, 4vw, 64px);
  }
  .dive {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: var(--dive-tint, var(--bg));
    opacity: 0;
    pointer-events: none;
    transition: opacity 450ms ease 380ms;
  }
  .dive[data-active] {
    opacity: 1;
  }
  @media (max-width: 767px) {
    .shelf {
      --box-w: 42vw;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 16px;
    }
  }
</style>
